###############################################################################
# ThinkCode — Coolify Environment Variables Template
#
# Copy values into the Coolify "Environment Variables" tab for your
# Docker Compose application.
###############################################################################

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=ThinkCode
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=app.yourdomain.com

# Application Key: Required in production. Run `php artisan key:generate --show` locally to generate.
APP_KEY=

# Security Policies
ALLOW_REGISTRATION=false
SANCTUM_TOKEN_EXPIRATION=10080
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ── PostgreSQL Database ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=thinkcode
DB_USERNAME=thinkcode_user
DB_PASSWORD=replace_with_secure_db_password

# ── Redis Cache, Queue & Session Broker ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_CLIENT=phpredis

# ── Service Drivers ─────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Mail Service ────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="ThinkCode"

# ── Automated Deployment Hooks ──────────────────────────────────────────────
# In production clusters, run migrations via Coolify deployment task or pre-deploy hook
RUN_MIGRATIONS=false
RUN_SEED=false
RUN_CACHE=true
GENERATE_APP_KEY=false

# ── Proxy Ingress (Traefik / Coolify bridge networks) ──────────────────────
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
