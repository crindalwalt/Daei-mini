###############################################################################
# ThinkCode Full-Stack Template — Environment Configuration
#
# Copy to `.env` before starting the application:
#   cp .env.example .env
###############################################################################

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=ThinkCode
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:5173,localhost:3000,127.0.0.1:8080,127.0.0.1:5173

# Application Key (generate with: make key-generate or php artisan key:generate)
APP_KEY=base64:l0nB9HnTuBKwLeIn4S3M32g2NW6h7gFi20bNHDVUSg8=

# ── Local Development Ports (docker-compose.dev.yml) ───────────────────────
FORWARD_HTTP_PORT=8080
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6379

# ── PostgreSQL Database ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=thinkcode
DB_USERNAME=thinkcode_user
DB_PASSWORD=thinkcode_db_secret

# ── Redis Cache, Queue & Session Broker ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=thinkcode_redis_secret
REDIS_CLIENT=phpredis

# ── Drivers & Storage ───────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Mail Service ────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@thinkcode.dev
MAIL_FROM_NAME="ThinkCode"

# ── Security & Feature Policies ─────────────────────────────────────────────
ALLOW_REGISTRATION=true
SANCTUM_TOKEN_EXPIRATION=10080
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# ── Automated Startup Hooks ─────────────────────────────────────────────────
RUN_MIGRATIONS=true
RUN_SEED=true
RUN_CACHE=false
GENERATE_APP_KEY=true

# ── Reverse Proxy / Traefik CIDRs (RFC 1918 internal networks) ─────────────
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

